# ============================================
# LinkedIn Bot - Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# Run 'python setup.py' to generate config.py with WBL API settings

# ============================================
# WBL API Configuration
# ============================================
# These are auto-generated by setup.py, but you can override them here

WBL_API_URL=http://localhost:8000/api
WBL_API_TOKEN=your-jwt-token-here
WBL_EMAIL=your@email.com
WBL_EMPLOYEE_ID=351
WBL_CANDIDATE_ID=0
WBL_EXTRACTION_JOB_ID=120

# ============================================
# Execution Configuration
# ============================================

# Number of messages to process (also in config.yaml)
MAX_MESSAGES_TO_PROCESS=20

# ============================================
# Logging Configuration
# ============================================

LOG_LEVEL=INFO
LOG_TO_FILE=true

# ============================================
# Development/Testing
# ============================================

# Set to true to test without making actual changes
DRY_RUN_MODE=false

# ============================================
# NOTES
# ============================================
# - LinkedIn credentials are in credentials/accounts.yaml
# - Chrome profile is configured per account in accounts.yaml
# - Most configuration is in config.yaml and config.py
# - Run 'python setup.py' to generate config.py with API credentials
