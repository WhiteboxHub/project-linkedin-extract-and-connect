# ============================================
# LINKEDIN CONTACT EXTRACTION BOT
# .gitignore - Files to exclude from Git
# ============================================

# ============================================
# CRITICAL - NEVER COMMIT THESE!
# ============================================

# Credentials & Secrets
config.py
.env
.env.local
.env.*.local

# API Tokens & Keys
*.pem
*.key
*.cert

# ============================================
# PYTHON
# ============================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv/
.venv

# ============================================
# DATA & DATABASES
# ============================================

# DuckDB databases
data/*.duckdb
data/*.duckdb.wal
data/*.db
*.duckdb
*.duckdb.wal
*.db

# CSV exports
data/*.csv
logs/*.csv
extracted_contacts_*.csv
marketing_candidates.csv

# Temporary data
*.tmp
*.temp
temp/
tmp/

# ============================================
# LOGS
# ============================================

# Log files
logs/
*.log
test_logs*/
test_logs_integration/
test_logs_integration_final/
test_logs_integration_temp/
test_logs_temp/

# Debug output
debug_*.png
debug_*.txt
test_output.txt

# ============================================
# BROWSER & DRIVERS
# ============================================

# WebDriver executables
chromedriver.exe
chromedriver
geckodriver.exe
geckodriver
msedgedriver.exe

# Browser profiles (if accidentally copied)
chrome_profiles/
firefox_profiles/

# ============================================
# IDE & EDITORS
# ============================================

# VSCode
.vscode/
*.code-workspace

# PyCharm / IntelliJ
